<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Meta name="ExplicitAutoJoints">true</Meta>
<Item class="ModuleScript" referent="RBX00065"><Properties><string name="Name">TerrainGenerator</string><ProtectedString name="Source"><![CDATA[--!strict
-- TerrainGenerator: a port of Minecraft Java 1.20.1's overworld generation to Roblox Terrain.
--
--   local TerrainGenerator = require(game.ServerScriptService.TerrainGenerator)
--   TerrainGenerator.Config.Seed = "MyWorldName"      -- optional, see Config.luau
--   TerrainGenerator.Start()                          -- server; clients start themselves
--   print(TerrainGenerator.GetBiomeAt(Vector3.new(0, 600, 0)))
--
-- By default (Config.TerrainMode = "Client") every client draws its own terrain and the server only decides where
-- trees, ores and structures go, calling Placement.placeThing for each. See README.md for the full API.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local Config = require(script.Config)
local Placement = require(script.Placement)
local Queries = require(script.World.Queries)
local ChunkGenerator = require(script.World.ChunkGenerator)
local Structures = require(script.World.Structures)
local Settings = require(script.Data.Settings)
local LockRegistry = require(script.Streaming.LockRegistry)
local Shared = require(script.Runtime.Shared)
local Server = require(script.Runtime.Server)
local Client = require(script.Runtime.Client)
local Biomes = require(script.Data.Biomes)

local MIN_Y = Settings.minY
local VOXEL = 4
local CHUNK = 16 * VOXEL

local TerrainGenerator = {}
TerrainGenerator.Version = "2.0.0"
TerrainGenerator.Config = Config

local function newSignal(): (BindableEvent, RBXScriptSignal)
	local e = Instance.new("BindableEvent")
	return e, e.Event
end

local signals: any = {}
signals.chunkLoaded, TerrainGenerator.ChunkLoaded = newSignal() -- (chunkX, chunkZ) loaded on this side (server: things; client: terrain)
signals.chunkUnloaded, TerrainGenerator.ChunkUnloaded = newSignal() -- (chunkX, chunkZ)
signals.initial, TerrainGenerator.InitialAreaLoaded = newSignal() -- () server: the area around the spawn point is generated
signals.spawn, TerrainGenerator.SpawnAreaReady = newSignal() -- () the spawn area is ready (server side / this client)

local customBiomes: { any } = {}
local locks = LockRegistry.new()
local serverCtl: any = nil
local clientCtl: any = nil
local queryGen: any = nil
local queryKey = ""

local function baseY(): number
	return Shared.baseY(Config)
end

-- ---------------------------------------------------------------------------------------- coordinates
-- Studs <-> Minecraft blocks (1 block = 4 studs; block y = -64 sits at Config.BedrockLevel).
function TerrainGenerator.WorldToBlock(position: Vector3): (number, number, number)
	return math.floor(position.X / VOXEL), math.floor((position.Y - baseY()) / VOXEL) + MIN_Y, math.floor(position.Z / VOXEL)
end

function TerrainGenerator.BlockToWorld(bx: number, by: number, bz: number): Vector3
	return Vector3.new(bx * VOXEL, baseY() + (by - MIN_Y) * VOXEL, bz * VOXEL)
end

function TerrainGenerator.WorldToChunk(position: Vector3): (number, number)
	return math.floor(position.X / CHUNK), math.floor(position.Z / CHUNK)
end

-- ---------------------------------------------------------------------------------------- queries
-- A generator instance on the calling thread, only for read-only queries (biome / height lookups).
local function getQueryGenerator(): any
	local key = tostring(Config.Seed) .. "|" .. #customBiomes .. "|" .. table.concat(Config.Biomes.Disabled, ",")
	if queryGen == nil or queryKey ~= key then
		queryGen = ChunkGenerator.new(Config.Seed, Shared.generatorOptions(Config, "query", customBiomes))
		queryKey = key
	end
	return queryGen
end

-- Approximate surface height in studs (top of the highest solid block) at world position (x, z).
function TerrainGenerator.GetHeightAt(x: number, z: number): number
	local by = Queries.surfaceY(getQueryGenerator(), math.floor(x / VOXEL), math.floor(z / VOXEL))
	return baseY() + (by - MIN_Y + 1) * VOXEL
end

-- Biome at a world position. Accepts a Vector3 (uses its Y) or (x, z) (uses the surface height).
-- Returns the biome name ("plains", "jagged_peaks", or a custom biome id) and an info table:
--   { Id, DisplayName, IsCustom, Base, Block = Vector3, Climate = {temperature, humidity, ...} }
function TerrainGenerator.GetBiomeAt(a: Vector3 | number, z: number?): (string, { [string]: any })
	local gen = getQueryGenerator()
	local bx, by, bz
	if typeof(a) == "Vector3" then
		bx, by, bz = TerrainGenerator.WorldToBlock(a)
	else
		bx, bz = math.floor((a :: number) / VOXEL), math.floor((z :: number) / VOXEL)
		by = Queries.surfaceY(gen, bx, bz)
	end
	local id = gen.biomes:getBiome(bx, by, bz)
	local registry = gen.registry
	local name = registry.names[id]
	local custom = registry.custom[id]
	return name,
		{
			Id = name,
			DisplayName = custom and custom.displayName or name,
			IsCustom = custom ~= nil,
			Base = registry.names[registry.base[id]],
			Block = Vector3.new(bx, by, bz),
			Climate = Queries.climate(gen, bx, by, bz),
		}
end

-- Raw climate values (temperature, humidity, continentalness, erosion, depth, weirdness) at a position.
function TerrainGenerator.GetClimateAt(position: Vector3): { [string]: number }
	local bx, by, bz = TerrainGenerator.WorldToBlock(position)
	return Queries.climate(getQueryGenerator(), bx, by, bz)
end

-- Every biome name (vanilla + registered custom ones), sorted.
function TerrainGenerator.GetBiomeNames(): { string }
	local names = {}
	for name in Biomes do
		table.insert(names, name)
	end
	for _, def in customBiomes do
		table.insert(names, def.id)
	end
	table.sort(names)
	return names
end

-- The names of all things that can be placed: { Trees = {...}, Ores = {...}, Structures = {...} } (sorted).
function TerrainGenerator.GetThingNames(): { [string]: { string } }
	local function keys(map: { [string]: any }): { string }
		local out = {}
		for k in map do
			table.insert(out, k)
		end
		table.sort(out)
		return out
	end
	return { Trees = keys(Config.Trees), Ores = keys(Config.Ores), Structures = keys(Config.Structures) }
end

-- ---------------------------------------------------------------------------------------- registering things
local function assertNotStarted(what: string)
	assert(serverCtl == nil and clientCtl == nil, what .. " must be called before TerrainGenerator.Start()")
end

-- Registers a "magical" biome (plain data, see World/BiomeRegistry.luau). Call before Start().
function TerrainGenerator.RegisterBiome(definition: any)
	assertNotStarted("RegisterBiome")
	assert(type(definition) == "table" and type(definition.id) == "string", "biome definition needs a string `id`")
	for _, existing in customBiomes do
		assert(existing.id ~= definition.id, "duplicate biome id " .. definition.id)
	end
	local def = table.clone(definition)
	def.base = def.base or "plains"
	table.insert(customBiomes, def)
end

-- Removes a biome from the world: a registered custom biome is dropped, a vanilla one is disabled (its climate
-- range goes to the nearest remaining biome). Call before Start().
function TerrainGenerator.RemoveBiome(name: string)
	assertNotStarted("RemoveBiome")
	for i, def in customBiomes do
		if def.id == name then
			table.remove(customBiomes, i)
			return
		end
	end
	assert(Biomes[name] ~= nil, "unknown biome " .. tostring(name))
	if not table.find(Config.Biomes.Disabled, name) then
		table.insert(Config.Biomes.Disabled, name)
	end
end

-- Undoes RemoveBiome for a vanilla biome. Call before Start().
function TerrainGenerator.RestoreBiome(name: string)
	assertNotStarted("RestoreBiome")
	local i = table.find(Config.Biomes.Disabled, name)
	if i then
		table.remove(Config.Biomes.Disabled, i)
	end
end

-- Adds a tree type that spawns in the listed biomes (nil = everywhere):
--   RegisterTree({ Name = "Crystal Tree", Biomes = { "plains", "meadow" }, PerChunk = 2 })
-- Rate / BiomeRate work like for the default trees. It reaches placeThing under its Name.
function TerrainGenerator.RegisterTree(def: any)
	assertNotStarted("RegisterTree")
	assert(type(def) == "table" and type(def.Name) == "string" and def.Name ~= "", "tree needs a string `Name`")
	assert(Config.Trees[def.Name] == nil, def.Name .. " already exists: edit Config.Trees[\"" .. def.Name .. "\"] instead")
	Config.Trees[def.Name] = {
		Enabled = def.Enabled ~= false, Custom = true, Biomes = def.Biomes, PerChunk = def.PerChunk or 1,
		Rate = def.Rate or 1, BiomeRate = def.BiomeRate or {}, Extra = {},
	}
end

-- Adds an ore: RegisterOre({ Name = "Mythril Ore", Biomes = nil, PerChunk = 1.5, MinY = -60, MaxY = 0, Size = 6 })
-- MinY / MaxY are Minecraft block heights (-64 .. 319, sea level 63). One placeThing call per vein.
function TerrainGenerator.RegisterOre(def: any)
	assertNotStarted("RegisterOre")
	assert(type(def) == "table" and type(def.Name) == "string" and def.Name ~= "", "ore needs a string `Name`")
	assert(Config.Ores[def.Name] == nil, def.Name .. " already exists: edit Config.Ores[\"" .. def.Name .. "\"] instead")
	Config.Ores[def.Name] = {
		Enabled = def.Enabled ~= false, Custom = true, Biomes = def.Biomes, PerChunk = def.PerChunk or 1,
		MinY = def.MinY or -60, MaxY = def.MaxY or 60, Size = def.Size or 4,
		Rate = def.Rate or 1, BiomeRate = def.BiomeRate or {}, Extra = {},
	}
end

-- Adds a structure; same fields as the entries of Config.Structures (see Config.luau):
--   RegisterStructure({ Name = "Pyramid", Spacing = 30, Separation = 10, Biomes = { "desert" } })
function TerrainGenerator.RegisterStructure(def: any)
	assertNotStarted("RegisterStructure")
	assert(type(def) == "table" and type(def.Name) == "string", "structure needs a string `Name`")
	assert(Config.Structures[def.Name] == nil, def.Name .. " already exists: edit Config.Structures[\"" .. def.Name .. "\"] instead")
	local rule = table.clone(def)
	Structures.normalize(def.Name, rule) -- validate now, with a readable error
	Config.Structures[def.Name] = rule
end

-- Adds a block for custom biome surfaces (`surface = { top = "crystal_stone" }`):
--   RegisterBlock({ Name = "crystal_stone", Material = "Glacier", Color = Color3.fromRGB(120, 200, 255) })
-- Roblox Terrain has ~22 materials, so Material must be the name of one of Enum.Material's terrain materials; the
-- Color recolours that material for every block that uses it.
function TerrainGenerator.RegisterBlock(def: any)
	assertNotStarted("RegisterBlock")
	assert(type(def) == "table" and type(def.Name) == "string" and type(def.Material) == "string", "block needs a Name and a Material (name of an Enum.Material)")
	assert((Enum.Material :: any)[def.Material] ~= nil, "unknown Terrain material " .. def.Material)
	table.insert(Config.Materials.Custom, { name = def.Name, material = def.Material, kind = def.Kind or "solid" })
	if def.Color then
		Config.Materials.Colors[def.Material] = def.Color
	end
end

-- ---------------------------------------------------------------------------------------- placement hooks
-- Instead of editing Placement.luau you can install handlers (server). onPlace(thingType, location, info) replaces
-- the print; onRemove(chunkX, chunkZ) is called when a chunk unloads and its things should go.
function TerrainGenerator.SetPlacementHandler(onPlace: (string, Vector3, any) -> ())
	Placement.setHandlers(onPlace, nil)
end

function TerrainGenerator.SetRemovalHandler(onRemove: (number, number) -> ())
	Placement.setHandlers(nil, onRemove)
end

-- ---------------------------------------------------------------------------------------- chunk locks and loading
-- A locked chunk stays loaded for everyone (every client draws it, the server keeps its things) until it is unlocked,
-- however far away all players are. Locks have owners (default "default"): a chunk stays locked while any owner holds
-- it, so scripts cannot unlock each other's chunks. Server only; they work before Start() too.
local function serverOnly(what: string)
	assert(RunService:IsServer(), what .. " can only be used on the server")
end

function TerrainGenerator.LockChunk(cx: number, cz: number, owner: string?)
	serverOnly("LockChunk")
	locks:lockChunk(cx, cz, owner)
end

-- Inclusive chunk rectangle. Returns how many chunks were newly locked.
function TerrainGenerator.LockArea(cx0: number, cz0: number, cx1: number, cz1: number, owner: string?): number
	serverOnly("LockArea")
	return locks:lockArea(cx0, cz0, cx1, cz1, owner)
end

function TerrainGenerator.UnlockChunk(cx: number, cz: number, owner: string?)
	serverOnly("UnlockChunk")
	locks:unlockChunk(cx, cz, owner)
end

function TerrainGenerator.UnlockArea(cx0: number, cz0: number, cx1: number, cz1: number, owner: string?): number
	serverOnly("UnlockArea")
	return locks:unlockArea(cx0, cz0, cx1, cz1, owner)
end

-- Releases everything one owner locked (default owner when nil).
function TerrainGenerator.UnlockAll(owner: string?): number
	serverOnly("UnlockAll")
	return locks:unlockAll(owner)
end

-- Locked by `owner`, or by anybody when owner is nil. Works on clients too (reads the replicated lock list).
function TerrainGenerator.IsChunkLocked(cx: number, cz: number, owner: string?): boolean
	if clientCtl and not RunService:IsServer() then
		return clientCtl.isLocked(cx, cz)
	end
	return locks:isLocked(cx, cz, owner)
end

function TerrainGenerator.GetLockedChunks(owner: string?): { { number } }
	serverOnly("GetLockedChunks")
	return locks:list(owner)
end

-- Loads the chunk (generates it and places its things) even if no player is anywhere near, and, by default, locks
-- it so it stays. Yields until it is loaded on the server. Server only; call after Start().
--   options.Lock          true (default): keep it loaded until UnlockChunk. false: keep it HoldSeconds (10) only
--   options.Owner         lock owner (default "LoadChunk")
--   options.Wait          false: do not yield
--   options.Timeout       seconds to wait (default 60)
-- A locked chunk is also loaded and drawn by every client, including players who join later.
-- Returns true when the chunk is loaded.
function TerrainGenerator.LoadChunk(cx: number, cz: number, options: any?): boolean
	serverOnly("LoadChunk")
	assert(serverCtl, "LoadChunk needs TerrainGenerator.Start() to have been called")
	return serverCtl.loadChunk(cx, cz, options)
end

-- ---------------------------------------------------------------------------------------- spawn hall / safe zone
-- Call this from your weapon scripts when `attacker` hurts (or tries to hurt) `victim`. When the victim stands in the
-- spawn hall's safe zone the attack is blocked and King Jeffry strikes the attacker with lightning. Returns true when
-- the attack was blocked (so you can skip your own damage). Server only; needs Config.SpawnHub.Enabled.
function TerrainGenerator.ReportAttack(attacker: Player, victim: Player): boolean
	serverOnly("ReportAttack")
	return serverCtl ~= nil and serverCtl.reportAttack(attacker, victim)
end

-- Is the player (or the world position, in studs) inside the spawn hall's safe zone? Players also carry the
-- attribute "InSafeZone" (true/false) for your UI.
function TerrainGenerator.IsInSafeZone(subject: Player | Vector3): boolean
	return serverCtl ~= nil and serverCtl.isInSafeZone(subject)
end

-- ---------------------------------------------------------------------------------------- streaming state
-- Server: the chunk's things have been placed. Client: its terrain is drawn.
function TerrainGenerator.IsChunkLoaded(cx: number, cz: number): boolean
	if serverCtl then
		return serverCtl.isLoaded(cx, cz)
	end
	return clientCtl ~= nil and clientCtl.isLoaded(cx, cz)
end

function TerrainGenerator.GetStats(): { [string]: number }
	if serverCtl then
		return serverCtl.stats()
	elseif clientCtl then
		return clientCtl.stats()
	end
	return { loaded = 0, queued = 0, inflight = 0, sources = 0, locked = 0 }
end

-- Server: yields until the area around the spawn point has been generated.
function TerrainGenerator.WaitForInitialArea()
	while serverCtl == nil or not serverCtl.initialLoaded() do
		task.wait(0.1)
	end
end

-- The point where players spawn (studs, on the ground); nil before Start().
function TerrainGenerator.GetSpawnPoint(): Vector3?
	if serverCtl then
		return serverCtl.spawnPoint
	elseif clientCtl then
		return clientCtl.spawnPoint
	end
	return nil
end

-- ---------------------------------------------------------------------------------------- start / stop
-- Copies the module into ReplicatedStorage (clients need its code) and installs the client runner.
local function deployClient()
	if not script:IsDescendantOf(ReplicatedStorage) then
		local existing = ReplicatedStorage:FindFirstChild("TerrainGenerator")
		if existing then
			existing:Destroy()
		end
		local copy = script:Clone()
		copy.Name = "TerrainGenerator"
		copy.Parent = ReplicatedStorage
	end
	local template = script:FindFirstChild("ClientRunner") :: LocalScript?
	if template then
		local function install(parent: Instance?)
			if parent and not parent:FindFirstChild("TerrainGeneratorClient") then
				local runner = template:Clone()
				runner.Name = "TerrainGeneratorClient"
				runner.Disabled = false
				runner.Parent = parent
			end
		end
		install(StarterPlayer:FindFirstChild("StarterPlayerScripts"))
		for _, player in Players:GetPlayers() do
			install(player:FindFirstChild("PlayerGui"))
		end
	end
end

-- Server: publishes the world to the clients and starts generating. Yields until the workers are ready.
function TerrainGenerator.StartServer()
	assert(RunService:IsServer(), "TerrainGenerator.StartServer() must run on the server")
	if serverCtl then
		return
	end
	local ok, result = pcall(Server.start, {
		Config = Config,
		module = script,
		customBiomes = customBiomes,
		locks = locks,
		getQueryGenerator = getQueryGenerator,
		deployClient = deployClient,
		signals = signals,
	})
	if not ok then
		-- never leave players stuck without characters if start-up failed
		Players.CharacterAutoLoads = true
		local state = ReplicatedStorage:FindFirstChild("TerrainGeneratorState")
		if state then
			state:Destroy()
		end
		local workers = game:GetService("ServerScriptService"):FindFirstChild("TerrainGeneratorWorkers")
		if workers then
			workers:Destroy()
		end
		error(result, 0)
	end
	serverCtl = result
end

-- Client: waits for the server's world, then draws the terrain around this player. Called by the client runner.
function TerrainGenerator.StartClient()
	if clientCtl then
		return
	end
	clientCtl = Client.start({
		Config = Config,
		module = script,
		signals = signals,
		setCustomBiomes = function(list: { any })
			customBiomes = list
			queryGen = nil
		end,
	})
end

-- Start the generator: on the server this runs StartServer, on a client StartClient.
function TerrainGenerator.Start()
	if RunService:IsServer() then
		TerrainGenerator.StartServer()
	else
		TerrainGenerator.StartClient()
	end
end

function TerrainGenerator.Stop()
	if serverCtl then
		serverCtl.stop()
		serverCtl = nil
	end
	if clientCtl then
		clientCtl.stop()
		clientCtl = nil
	end
end

return TerrainGenerator
]]></ProtectedString></Properties><Item class="LocalScript" referent="RBX00001"><Properties><string name="Name">ClientRunner</string><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[--!strict
-- Starts the terrain generator on a client. TerrainGenerator.Start() on the server installs a copy of this script
-- into StarterPlayerScripts (and into the PlayerGui of players already in the game), so you never place it yourself.
-- This template is disabled and never runs in place.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
if player:GetAttribute("TerrainGeneratorClientStarted") then
	return -- another copy of this runner is already running on this client
end
player:SetAttribute("TerrainGeneratorClientStarted", true)

local module = ReplicatedStorage:WaitForChild("TerrainGenerator", 120)
if module then
	require(module).StartClient()
else
	warn("[TerrainGenerator] the module never arrived in ReplicatedStorage")
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Terrain generator configuration. Edit the values here, or override them from a SERVER script BEFORE calling
-- TerrainGenerator.Start():
--
--     local TerrainGenerator = require(game.ServerScriptService.TerrainGenerator)
--     TerrainGenerator.Config.Seed = "MyWorldName"
--     TerrainGenerator.Config.Trees["Oak Tree"].Biomes = { "plains", "forest" }
--     TerrainGenerator.Start()
--
-- Whatever the server's Config holds at Start() is copied to every client, so clients generate the same world.
--
-- Scale: one Minecraft block = one Terrain voxel = 4 studs, and the world is Minecraft 1.20.1's overworld:
-- 384 blocks tall (Minecraft y -64 .. 319), sea level at Minecraft y 63. With BedrockLevel = 0 that puts the
-- bottom of the world at Y = 0, sea level at Y = 508 and the height limit at Y = 1536 studs.

local Biomes = require(script.Parent.Data.Biomes)
local ThingNames = require(script.Parent.World.ThingNames)

export type Config = {
	Seed: number | string,
	Width: number,
	Length: number,
	BedrockLevel: number,
	TerrainMode: string,
	SmoothTerrain: boolean,
	ApplyMaterialColors: boolean,
	ClearBeforeGenerating: boolean,
	PrintProgress: boolean,
	Decoration: boolean?,

	Streaming: {
		UpdateInterval: number,
		UnloadMargin: number,
		MaxChunksInFlight: number,
		PlayerGraceSeconds: number,
		KeepInitialArea: boolean,
		WriteBudgetMs: number,
		AdaptiveLoad: boolean,
		TargetFrameMs: number,
	},
	Server: { Width: number?, Length: number? },
	Workers: { Enabled: boolean, Count: number, SliceMs: number },
	Client: { Workers: number, SliceMs: number, WriteBudgetMs: number, MaxChunksInFlight: number, Width: number?, Length: number? },

	Placement: { Print: boolean, MaxPrintsPerSecond: number },
	Spawning: { TreeRate: number, OreRate: number, BiomeTreeRate: { [string]: number }, BiomeOreRate: { [string]: number } },
	Trees: { [string]: any },
	Ores: { [string]: any },
	Structures: { [string]: any },

	Biomes: { Disabled: { string } },
	Materials: { Blocks: { [string]: string }, Colors: { [string]: Color3 }, Variants: { [string]: string }, Custom: { any } },

	SpawnHub: { Enabled: boolean, Size: number, WallHeight: number, SafeMargin: number, KingName: string, Strike: { Damage: number, Cooldown: number, Knockback: number, StunSeconds: number, AttackRange: number } },
	Mobs: { Pig: boolean },
	Spawn: { AutoSpawn: boolean, ReadyRadiusChunks: number },
}

-- ---------------------------------------------------------------------------------------- defaults for the tables
-- One entry per vanilla biome, 1 = Minecraft's own frequency
local function perBiome(): { [string]: number }
	local t: { [string]: number } = {}
	for name in Biomes do
		t[name] = 1
	end
	return t
end

-- A rule for every default tree / ore, so you can see and edit them all.
--   Enabled    false = never spawns
--   Biomes     nil = wherever Minecraft spawns it, or a list like { "plains", "forest" } to restrict it to those
--   Rate       multiplier on Minecraft's frequency (1 = vanilla)
--   BiomeRate  { desert = 0 } extra per-biome multipliers on top of Rate
--   Extra      { desert = 2 } also spawn ~2 per chunk in biomes where Minecraft would not
local function defaultRules(names: { string }): { [string]: any }
	local t: { [string]: any } = {}
	for _, name in names do
		t[name] = { Enabled = true, Biomes = nil, Rate = 1, BiomeRate = {}, Extra = {} }
	end
	return t
end

local Config: Config = {
	-- A number, or any string (hashed like Minecraft does). The same seed gives the same biomes and terrain
	-- as Minecraft 1.20.1 Java at the same coordinates (Minecraft x,z = studs / 4).
	Seed = 12345,

	-- Size in studs of the terrain window kept loaded around every player. Rounded up to whole 64-stud chunks.
	-- Smaller = faster and lighter. (Client.Width / Client.Length can override it for what clients render.)
	Width = 1024,
	Length = 1024,

	-- Workspace Y (studs) of the bottom of the world; rounded down to a multiple of 4.
	BedrockLevel = 0,

	-- "Client": every player's own client generates and draws the terrain around them (no terrain network traffic,
	--           no server cost; the SERVER has no terrain, so server-side physics/raycasts see an empty world).
	--           Trees, ores and structures are still decided by the server.
	-- "Server": the server writes the terrain like a normal Roblox world (replicated to everybody).
	TerrainMode = "Client",

	-- Sub-voxel occupancy (smooth hills) instead of hard 4-stud cubes.
	SmoothTerrain = true,

	-- Recolour Terrain materials so they resemble Minecraft's blocks (see Materials below and World/Blocks.luau).
	ApplyMaterialColors = true,

	ClearBeforeGenerating = true,
	PrintProgress = true,

	-- false turns off Terrain grass blades (a big client FPS saver); true = on; nil = leave unchanged
	Decoration = false,

	Streaming = {
		UpdateInterval = 0.25, -- seconds between player position checks
		UnloadMargin = 2, -- extra chunks kept around each window before unloading (prevents flicker)
		MaxChunksInFlight = 4, -- concurrent chunk jobs on the server (capped at Workers.Count)
		PlayerGraceSeconds = 30, -- a player without a character (respawning) keeps its window this long
		KeepInitialArea = false, -- TerrainMode "Server" only: never unload the start-up area around (0, 0)
		WriteBudgetMs = 3, -- TerrainMode "Server": terrain writes yield to the next frame after this many ms
		AdaptiveLoad = true, -- fewer concurrent chunk jobs (or a pause) while frames are slow
		TargetFrameMs = 25, -- ... i.e. when frames take longer than this (25 ms = 40 fps)
	},

	-- How far around every player the SERVER places trees, ores and structures (nil = Width / Length above).
	-- Smaller = less server CPU; things beyond this distance do not exist yet when a client already draws the terrain.
	Server = {
		Width = nil,
		Length = nil,
	},

	-- Server-side generation workers (Parallel Luau Actors). They compute where trees, ores and structures go.
	Workers = {
		Enabled = true, -- false = generate on the main thread (causes hitches)
		Count = 3,
		SliceMs = 6, -- a worker hands the frame back after this many ms of work, so chunks never hitch a frame
	},

	-- What each player's client does in TerrainMode "Client".
	Client = {
		Workers = 2, -- parallel workers per client (more = faster terrain, more CPU on the player's device)
		SliceMs = 4, -- ms of generation per frame per worker
		WriteBudgetMs = 2, -- ms of Terrain writes per frame
		MaxChunksInFlight = 2,
		Width = nil, -- nil = use Width / Length above
		Length = nil,
	},

	-- Where the placeThing calls go: Placement.luau (printing only). Printing is rate limited.
	Placement = {
		Print = true,
		MaxPrintsPerSecond = 40,
	},

	-- Spawn rates. 1 = Minecraft's own density. Rates multiply: global x per-biome x per-thing x per-thing-per-biome.
	Spawning = {
		TreeRate = 1, -- all trees
		OreRate = 1, -- all ores
		BiomeTreeRate = perBiome(), -- e.g. BiomeTreeRate.forest = 2 doubles every tree in forests
		BiomeOreRate = perBiome(),
	},

	-- Rules for every default tree and ore; see defaultRules above. RegisterTree / RegisterOre add your own.
	Trees = defaultRules(ThingNames.treeList),
	Ores = defaultRules(ThingNames.oreList),

	-- Structures. Spacing / Separation / Salt are Minecraft's `random_spread` numbers (Village uses vanilla's own, so
	-- villages start in the same chunks as in Minecraft); one structure per Spacing x Spacing chunk region, at least
	-- Separation chunks from the next. 1 chunk = 64 studs.
	--   Biomes     where it may start (biome names, custom biome ids work too)
	--   Placement  "Land" | "Water" (sea floor) | "Any"        MaxSlope  max ground height difference (blocks)
	--   Chance     0..1 per region       Rotate  random 90 degree turns       Enabled  false = never
	-- RegisterStructure adds your own.
	Structures = {
		Village = {
			Enabled = true, Spacing = 34, Separation = 8, Salt = 10387312,
			Biomes = { "plains", "sunflower_plains", "meadow", "forest", "flower_forest", "birch_forest" },
			Placement = "Land", MaxSlope = 6,
		},
		["Medieval Castle"] = {
			Enabled = true, Spacing = 48, Separation = 20, Salt = 8154021, Chance = 0.8,
			Biomes = { "snowy_slopes", "jagged_peaks", "frozen_peaks", "grove", "snowy_plains", "snowy_taiga" },
			Placement = "Land", MaxSlope = 14,
		},
		Watchtower = {
			Enabled = true, Spacing = 20, Separation = 8, Salt = 5100401, Chance = 0.8,
			Biomes = { "plains", "meadow", "forest", "taiga", "savanna", "sunflower_plains", "birch_forest" },
			Placement = "Land", MaxSlope = 4,
		},
		Well = {
			Enabled = true, Spacing = 11, Separation = 4, Salt = 5100402, Chance = 0.6,
			Biomes = { "plains", "sunflower_plains", "meadow", "desert", "savanna" },
			Placement = "Land", MaxSlope = 3,
		},
		Campsite = {
			Enabled = true, Spacing = 14, Separation = 5, Salt = 5100403, Chance = 0.7,
			Biomes = { "forest", "birch_forest", "taiga", "plains", "flower_forest", "snowy_taiga" },
			Placement = "Land", MaxSlope = 3,
		},
		["Lone Cabin"] = {
			Enabled = true, Spacing = 26, Separation = 10, Salt = 5100404, Chance = 0.7,
			Biomes = { "forest", "dark_forest", "taiga", "snowy_taiga", "old_growth_pine_taiga", "birch_forest" },
			Placement = "Land", MaxSlope = 4,
		},
		["Ruined Tower"] = {
			Enabled = true, Spacing = 24, Separation = 9, Salt = 5100405, Chance = 0.6,
			Biomes = { "plains", "forest", "swamp", "taiga", "savanna", "badlands", "windswept_hills" },
			Placement = "Land", MaxSlope = 5,
		},
		["Stone Circle"] = {
			Enabled = true, Spacing = 22, Separation = 8, Salt = 5100406, Chance = 0.6,
			Biomes = { "plains", "meadow", "sunflower_plains", "windswept_hills", "snowy_plains" },
			Placement = "Land", MaxSlope = 3,
		},
		["Mountain Shrine"] = {
			Enabled = true, Spacing = 22, Separation = 8, Salt = 5100407, Chance = 0.6,
			Biomes = { "windswept_hills", "stony_peaks", "jagged_peaks", "snowy_slopes", "frozen_peaks", "grove" },
			Placement = "Land", MaxSlope = 10,
		},
	},

	-- Remove biomes from the world: their climate range is taken over by the nearest remaining biome.
	-- e.g. Disabled = { "desert", "badlands" }. Add biomes with TerrainGenerator.RegisterBiome.
	Biomes = {
		Disabled = {},
	},

	-- Terrain materials. Roblox Terrain has only ~22 materials, so several Minecraft blocks share one.
	--   Blocks    { grass_block = "LeafyGrass" }: show a block with another Enum.Material (name)
	--   Colors    { Grass = Color3.fromRGB(...) }: recolour a Terrain material (needs ApplyMaterialColors)
	--   Variants  { Grass = "MyGrassVariant" }: apply a MaterialVariant (from MaterialService) to a base material,
	--             giving it custom textures
	--   Custom    new blocks for custom biome surfaces: { { name = "crystal_stone", material = "Glacier" } }
	--             (RegisterBlock adds one)
	Materials = {
		Blocks = {},
		Colors = {},
		Variants = {},
		Custom = {},
	},

	-- The spawn hall: a building at the spawn point where everyone spawns. It is a safe zone (nobody can be hurt inside),
	-- and King Jeffry strikes anyone who attacks someone in there with lightning. Roblox has no built-in combat, so
	-- attacks are detected by TerrainGenerator.ReportAttack(attacker, victim) (call it from your weapons), by health
	-- loss inside the zone (classic `creator` tag) and by tool swings next to somebody inside (AttackRange studs).
	SpawnHub = {
		Enabled = true,
		Size = 56, -- studs, square hall
		WallHeight = 18,
		SafeMargin = 8, -- the safe zone reaches this far past the walls
		KingName = "Jeffry",
		Strike = { Damage = 40, Cooldown = 3, Knockback = 60, StunSeconds = 1.2, AttackRange = 14 },
	},

	Mobs = {
		Pig = true, -- one wandering pig at the spawn point (drawn on each client)
	},

	Spawn = {
		AutoSpawn = true, -- hold characters until the area around the spawn point exists on their client
		ReadyRadiusChunks = 2, -- this many chunks around the spawn point are locked and loaded for everybody
	},
}

return Config
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00007"><Properties><string name="Name">Core</string></Properties><Item class="ModuleScript" referent="RBX00003"><Properties><string name="Name">Hash</string><ProtectedString name="Source"><![CDATA[--!strict
--!native
-- MD5 (noise names -> seeds) and SHA-256 (biome zoom seed), on bit32.

local band, bor, bxor, bnot = bit32.band, bit32.bor, bit32.bxor, bit32.bnot
local rshift, lrotate, rrotate = bit32.rshift, bit32.lrotate, bit32.rrotate

local Hash = {}

-- ---------------------------------------------------------------- MD5
local MD5_K: { number } = {}
for i = 0, 63 do
	MD5_K[i + 1] = math.floor(math.abs(math.sin(i + 1)) * 4294967296)
end
local MD5_S = {
	7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
	5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
	4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
	6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
}

-- Returns the 16 digest bytes.
function Hash.md5Bytes(msg: string): { number }
	local len = #msg
	local padLen = (56 - (len + 1) % 64) % 64
	local data = msg .. "\128" .. string.rep("\0", padLen)
	-- 64 bit little-endian bit length
	local bits = len * 8
	data ..= string.pack("<I4I4", bits % 4294967296, math.floor(bits / 4294967296))

	local a0, b0, c0, d0 = 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476
	local M = table.create(16, 0)
	for chunk = 1, #data, 64 do
		for i = 0, 15 do
			M[i + 1] = string.unpack("<I4", data, chunk + i * 4)
		end
		local A, B, C, D = a0, b0, c0, d0
		for i = 0, 63 do
			local F, g
			if i < 16 then
				F = bor(band(B, C), band(bnot(B), D))
				g = i
			elseif i < 32 then
				F = bor(band(D, B), band(bnot(D), C))
				g = (5 * i + 1) % 16
			elseif i < 48 then
				F = bxor(B, bxor(C, D))
				g = (3 * i + 5) % 16
			else
				F = bxor(C, bor(B, bnot(D)))
				g = (7 * i) % 16
			end
			F = (F + A + MD5_K[i + 1] + M[g + 1]) % 4294967296
			A = D
			D = C
			C = B
			B = (B + lrotate(F, MD5_S[i + 1])) % 4294967296
		end
		a0 = (a0 + A) % 4294967296
		b0 = (b0 + B) % 4294967296
		c0 = (c0 + C) % 4294967296
		d0 = (d0 + D) % 4294967296
	end
	local out = string.pack("<I4I4I4I4", a0, b0, c0, d0)
	local bytes = {}
	for i = 1, 16 do
		bytes[i] = string.byte(out, i)
	end
	return bytes
end

-- The MD5 digest as two big-endian 64 bit longs, each as (hi, lo): what Guava's Longs.fromBytes produces.
function Hash.md5Longs(msg: string): (number, number, number, number)
	local b = Hash.md5Bytes(msg)
	local function word(i: number): number
		return b[i] * 16777216 + b[i + 1] * 65536 + b[i + 2] * 256 + b[i + 3]
	end
	return word(1), word(5), word(9), word(13)
end

function Hash.md5Hex(msg: string): string
	local b = Hash.md5Bytes(msg)
	local t = {}
	for i = 1, 16 do
		t[i] = string.format("%02x", b[i])
	end
	return table.concat(t)
end

-- ---------------------------------------------------------------- SHA-256
local SHA_K: { number } = {}
do
	local primes = {}
	local n = 2
	while #primes < 64 do
		local isPrime = true
		for _, p in primes do
			if p * p > n then
				break
			end
			if n % p == 0 then
				isPrime = false
				break
			end
		end
		if isPrime then
			table.insert(primes, n)
		end
		n += 1
	end
	for i, p in primes do
		local c = p ^ (1 / 3)
		SHA_K[i] = math.floor((c - math.floor(c)) * 4294967296)
	end
end

function Hash.sha256Bytes(msg: string): { number }
	local len = #msg
	local padLen = (56 - (len + 1) % 64) % 64
	local bits = len * 8
	local data = msg .. "\128" .. string.rep("\0", padLen) .. string.pack(">I4I4", math.floor(bits / 4294967296), bits % 4294967296)
	local H = {
		0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
	}
	local w = table.create(64, 0)
	for chunk = 1, #data, 64 do
		for i = 0, 15 do
			w[i + 1] = string.unpack(">I4", data, chunk + i * 4)
		end
		for i = 16, 63 do
			local w15, w2 = w[i - 14], w[i - 1]
			local s0 = bxor(rrotate(w15, 7), rrotate(w15, 18), rshift(w15, 3))
			local s1 = bxor(rrotate(w2, 17), rrotate(w2, 19), rshift(w2, 10))
			w[i + 1] = (w[i - 15] + s0 + w[i - 6] + s1) % 4294967296
		end
		local a, b, c, d, e, f, g, h = H[1], H[2], H[3], H[4], H[5], H[6], H[7], H[8]
		for i = 0, 63 do
			local S1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
			local ch = bxor(band(e, f), band(bnot(e), g))
			local t1 = (h + S1 + ch + SHA_K[i + 1] + w[i + 1]) % 4294967296
			local S0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
			local maj = bxor(band(a, b), band(a, c), band(b, c))
			local t2 = (S0 + maj) % 4294967296
			h, g, f, e, d, c, b, a = g, f, e, (d + t1) % 4294967296, c, b, a, (t1 + t2) % 4294967296
		end
		H[1] = (H[1] + a) % 4294967296
		H[2] = (H[2] + b) % 4294967296
		H[3] = (H[3] + c) % 4294967296
		H[4] = (H[4] + d) % 4294967296
		H[5] = (H[5] + e) % 4294967296
		H[6] = (H[6] + f) % 4294967296
		H[7] = (H[7] + g) % 4294967296
		H[8] = (H[8] + h) % 4294967296
	end
	local out = string.pack(">I4I4I4I4I4I4I4I4", table.unpack(H))
	local bytes = {}
	for i = 1, 32 do
		bytes[i] = string.byte(out, i)
	end
	return bytes
end

function Hash.sha256Hex(msg: string): string
	local b = Hash.sha256Bytes(msg)
	local t = {}
	for i = 1, 32 do
		t[i] = string.format("%02x", b[i])
	end
	return table.concat(t)
end

return Hash
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00004"><Properties><string name="Name">Int64</string><ProtectedString name="Source"><![CDATA[--!strict
--!native
-- 64-bit integer arithmetic on (hi, lo) pairs of uint32 numbers.
-- Luau has no int64; Minecraft's RNG/seed maths depends on exact 64-bit wraparound.

local band, bor, bxor = bit32.band, bit32.bor, bit32.bxor
local lshift, rshift, arshift = bit32.lshift, bit32.rshift, bit32.arshift

local TWO32 = 4294967296

local Int64 = {}

function Int64.add(ah: number, al: number, bh: number, bl: number): (number, number)
	local l = al + bl
	local carry = 0
	if l >= TWO32 then
		l -= TWO32
		carry = 1
	end
	return (ah + bh + carry) % TWO32, l
end

function Int64.neg(h: number, l: number): (number, number)
	local nl = (TWO32 - l) % TWO32
	local nh = (bxor(h, 0xFFFFFFFF) + (l == 0 and 1 or 0)) % TWO32
	return nh, nl
end

function Int64.sub(ah: number, al: number, bh: number, bl: number): (number, number)
	local nh, nl = Int64.neg(bh, bl)
	return Int64.add(ah, al, nh, nl)
end

function Int64.xor(ah: number, al: number, bh: number, bl: number): (number, number)
	return bxor(ah, bh), bxor(al, bl)
end

function Int64.band(ah: number, al: number, bh: number, bl: number): (number, number)
	return band(ah, bh), band(al, bl)
end

function Int64.bor(ah: number, al: number, bh: number, bl: number): (number, number)
	return bor(ah, bh), bor(al, bl)
end

-- logical shift left, 0 <= n < 64
function Int64.shl(h: number, l: number, n: number): (number, number)
	if n == 0 then
		return h, l
	elseif n < 32 then
		return bor(lshift(h, n), rshift(l, 32 - n)), lshift(l, n)
	else
		return lshift(l, n - 32), 0
	end
end

-- logical shift right, 0 <= n < 64
function Int64.shr(h: number, l: number, n: number): (number, number)
	if n == 0 then
		return h, l
	elseif n < 32 then
		return rshift(h, n), bor(rshift(l, n), lshift(h, 32 - n))
	else
		return 0, rshift(h, n - 32)
	end
end

-- arithmetic shift right (sign extending), 0 <= n < 64
function Int64.sar(h: number, l: number, n: number): (number, number)
	if n == 0 then
		return h, l
	elseif n < 32 then
		return arshift(h, n), bor(rshift(l, n), lshift(h, 32 - n))
	else
		local fill = h >= 0x80000000 and 0xFFFFFFFF or 0
		return fill, arshift(h, n - 32)
	end
end

function Int64.rotl(h: number, l: number, n: number): (number, number)
	n %= 64
	if n == 0 then
		return h, l
	end
	if n >= 32 then
		h, l = l, h
		n -= 32
		if n == 0 then
			return h, l
		end
	end
	return bor(lshift(h, n), rshift(l, 32 - n)), bor(lshift(l, n), rshift(h, 32 - n))
end

-- low 32 bits of x * y for uint32 x, y (exact in doubles via a 16 bit split)
local function mul32lo(x: number, y: number): number
	local xh = rshift(x, 16)
	local xl = band(x, 0xFFFF)
	return (((xh * y) % 65536) * 65536 + xl * y) % TWO32
end
Int64.mul32lo = mul32lo

-- (a * b) mod 2^64
function Int64.mul(ah: number, al: number, bh: number, bl: number): (number, number)
	local a0, a1 = band(al, 0xFFFF), rshift(al, 16)
	local b0, b1 = band(bl, 0xFFFF), rshift(bl, 16)
	local p00 = a0 * b0
	local mid = a0 * b1 + a1 * b0
	local lowFull = p00 + (mid % 65536) * 65536
	local low32 = lowFull % TWO32
	local high = a1 * b1 + (mid - mid % 65536) / 65536 + (lowFull - low32) / TWO32
	local h = (high + mul32lo(ah, bl) + mul32lo(al, bh)) % TWO32
	return h, low32
end

-- Converts an integer-valued double (|n| < 2^63, exact only below 2^53) to (hi, lo) two's complement.
function Int64.fromNumber(n: number): (number, number)
	if n >= 0 then
		local lo = n % TWO32
		return ((n - lo) / TWO32) % TWO32, lo
	end
	local m = -n
	local lo = m % TWO32
	return Int64.neg(((m - lo) / TWO32) % TWO32, lo)
end

-- Sign-extends a 32-bit signed integer stored in a double.
function Int64.fromInt32(n: number): (number, number)
	local u = n % TWO32
	return (u >= 0x80000000) and 0xFFFFFFFF or 0, u
end

-- Wraps an integer-valued double into the signed 32-bit range.
function Int64.wrap32(n: number): number
	local u = n % TWO32
	if u >= 0x80000000 then
		u -= TWO32
	end
	return u
end

-- Signed double approximation of (hi, lo) (exact when |value| < 2^53).
function Int64.toNumber(h: number, l: number): number
	if h >= 0x80000000 then
		local nh, nl = Int64.neg(h, l)
		return -(nh * TWO32 + nl)
	end
	return h * TWO32 + l
end

function Int64.toHex(h: number, l: number): string
	return string.format("%08x%08x", h, l)
end

-- Parses a decimal string like "-4172144997902289642" into (hi, lo); returns nil when malformed.
function Int64.parse(s: string): (number?, number?)
	local sign, digits = string.match(s, "^%s*([+-]?)(%d+)%s*$")
	if not digits then
		return nil, nil
	end
	local h, l = 0, 0
	for i = 1, #digits do
		h, l = Int64.mul(h, l, 0, 10)
		h, l = Int64.add(h, l, 0, string.byte(digits, i) - 48)
	end
	if sign == "-" then
		h, l = Int64.neg(h, l)
	end
	return h, l
end

-- Java's String.hashCode() (UTF-16 code units; BMP-only strings are exact, others use UTF-8 bytes).
function Int64.javaStringHash(s: string): number
	local h = 0
	for _, cp in utf8.codes(s) do
		if cp >= 0x10000 then
			cp -= 0x10000
			local hi, lo = 0xD800 + rshift(cp, 10), 0xDC00 + band(cp, 0x3FF)
			h = (mul32lo(h, 31) + hi) % TWO32
			h = (mul32lo(h, 31) + lo) % TWO32
		else
			h = (mul32lo(h, 31) + cp) % TWO32
		end
	end
	return Int64.wrap32(h)
end

return Int64
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00005"><Properties><string name="Name">JavaRandom</string><ProtectedString name="Source"><![CDATA[--!strict
--!native
-- java.util.Random / Minecraft's LegacyRandomSource: a 48 bit LCG kept in two 24 bit limbs so every
-- product stays exact in a double.  Used by the classic carvers (caves, canyons) and legacy noise.

local Int64 = require(script.Parent.Int64)

local TWO24 = 16777216
local TWO32 = 4294967296
local M0 = 0xECE66D -- low 24 bits of 0x5DEECE66D
local M1 = 0x5DE -- the rest
local TWO53_INV = 1.1102230246251565e-16
local DIV: { number } = {} -- DIV[bits] = 2^(48 - bits)
for bits = 1, 32 do
	DIV[bits] = 2 ^ (48 - bits)
end

export type JavaRandom = {
	s0: number, -- bits 0..23
	s1: number, -- bits 24..47
	setSeed: (JavaRandom, number, number) -> (),
	next: (JavaRandom, number) -> number,
	nextInt: (JavaRandom, number?) -> number,
	nextLong: (JavaRandom) -> (number, number),
	nextFloat: (JavaRandom) -> number,
	nextDouble: (JavaRandom) -> number,
	nextBoolean: (JavaRandom) -> boolean,
}

local JavaRandom = {}
JavaRandom.__index = JavaRandom

-- seed given as a signed 64 bit (hi, lo)
function JavaRandom.new(seedH: number, seedL: number): JavaRandom
	local self = setmetatable({ s0 = 0, s1 = 0 }, JavaRandom) :: any
	self:setSeed(seedH, seedL)
	return self
end

function JavaRandom.setSeed(self: JavaRandom, seedH: number, seedL: number)
	-- (seed ^ 0x5DEECE66D) & (2^48 - 1)
	local s0 = bit32.band(seedL, 0xFFFFFF)
	local s1 = bit32.band(bit32.bor(bit32.rshift(seedL, 24), bit32.lshift(bit32.band(seedH, 0xFFFF), 8)), 0xFFFFFF)
	self.s0 = bit32.bxor(s0, M0)
	self.s1 = bit32.bxor(s1, M1)
end

function JavaRandom.next(self: JavaRandom, bits: number): number
	local s0, s1 = self.s0, self.s1
	local t0 = s0 * M0 + 11
	local n0 = t0 % TWO24
	local carry = (t0 - n0) / TWO24
	local t1 = s1 * M0 + s0 * M1 + carry
	local n1 = t1 % TWO24
	self.s0, self.s1 = n0, n1
	local state = n1 * TWO24 + n0
	local v = math.floor(state / DIV[bits])
	if bits == 32 and v >= 2147483648 then
		v -= TWO32
	end
	return v
end

function JavaRandom.nextInt(self: JavaRandom, bound: number?): number
	if bound == nil then
		return self:next(32)
	end
	assert(bound > 0, "bound must be positive")
	if bit32.band(bound, bound - 1) == 0 then
		return math.floor(bound * self:next(31) / 2147483648)
	end
	while true do
		local bits = self:next(31)
		local val = bits % bound
		if bits - val + (bound - 1) < 2147483648 then
			return val
		end
	end
end

function JavaRandom.nextLong(self: JavaRandom): (number, number)
	local i = self:next(32)
	local j = self:next(32)
	local h = (i % TWO32 + (j < 0 and -1 or 0)) % TWO32
	return h, j % TWO32
end

function JavaRandom.nextFloat(self: JavaRandom): number
	return self:next(24) * 5.9604644775390625e-8
end

function JavaRandom.nextDouble(self: JavaRandom): number
	local a = self:next(26)
	local b = self:next(27)
	return (a * 134217728 + b) * TWO53_INV
end

function JavaRandom.nextBoolean(self: JavaRandom): boolean
	return self:next(1) ~= 0
end

-- WorldgenRandom.setLargeFeatureSeed(baseSeed, chunkX, chunkZ); the base seed is (hi, lo)
function JavaRandom.setLargeFeatureSeed(self: JavaRandom, baseH: number, baseL: number, chunkX: number, chunkZ: number)
	self:setSeed(baseH, baseL)
	local ih, il = self:nextLong()
	local jh, jl = self:nextLong()
	local xh, xl = Int64.fromInt32(chunkX)
	local zh, zl = Int64.fromInt32(chunkZ)
	xh, xl = Int64.mul(xh, xl, ih, il)
	zh, zl = Int64.mul(zh, zl, jh, jl)
	local kh, kl = Int64.xor(xh, xl, zh, zl)
	kh, kl = Int64.xor(kh, kl, baseH, baseL)
	self:setSeed(kh, kl)
end

return JavaRandom
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00006"><Properties><string name="Name">Xoroshiro</string><ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Minecraft's XoroshiroRandomSource (xoroshiro128++), RandomSupport seed upgrade,
-- and the positional random factory used to seed every noise, aquifer and surface rule.

local Int64 = require(script.Parent.Int64)
local Hash = require(script.Parent.Hash)

local band, bxor, rshift = bit32.band, bit32.bxor, bit32.rshift
local rotl64, add64, mul64, shr64, shl64, xor64 = Int64.rotl, Int64.add, Int64.mul, Int64.shr, Int64.shl, Int64.xor

local TWO32 = 4294967296
local TWO53_INV = 1.1102230246251565e-16 -- 2^-53
local TWO24_INV = 5.9604644775390625e-8 -- 2^-24

local GOLDEN_H, GOLDEN_L = 0x9E3779B9, 0x7F4A7C15
local SILVER_H, SILVER_L = 0x6A09E667, 0xF3BCC909

export type Xoroshiro = {
	a: number, -- state lo, high word
	b: number, -- state lo, low word
	c: number, -- state hi, high word
	d: number, -- state hi, low word
	nextLong: (Xoroshiro) -> (number, number),
	nextInt: (Xoroshiro, number?) -> number,
	nextDouble: (Xoroshiro) -> number,
	nextFloat: (Xoroshiro) -> number,
	nextBoolean: (Xoroshiro) -> boolean,
	forkPositional: (Xoroshiro) -> PositionalFactory,
}

export type PositionalFactory = {
	lh: number,
	ll: number,
	hh: number,
	hl: number,
	at: (PositionalFactory, number, number, number) -> Xoroshiro,
	fromHashOf: (PositionalFactory, string) -> Xoroshiro,
}

local Xoroshiro = {}
Xoroshiro.__index = Xoroshiro

local Factory = {}
Factory.__index = Factory

-- mixStafford13 on a 64 bit value
local function mix13(h: number, l: number): (number, number)
	local sh, sl = shr64(h, l, 30)
	h, l = xor64(h, l, sh, sl)
	h, l = mul64(h, l, 0xBF58476D, 0x1CE4E5B9)
	sh, sl = shr64(h, l, 27)
	h, l = xor64(h, l, sh, sl)
	h, l = mul64(h, l, 0x94D049BB, 0x133111EB)
	sh, sl = shr64(h, l, 31)
	return xor64(h, l, sh, sl)
end

-- RandomSupport.upgradeSeedTo128bit: 64 bit seed -> (loH, loL, hiH, hiL)
local function upgradeSeed(sh: number, sl: number): (number, number, number, number)
	local ih, il = xor64(sh, sl, SILVER_H, SILVER_L)
	local jh, jl = add64(ih, il, GOLDEN_H, GOLDEN_L)
	local lh, ll = mix13(ih, il)
	local hh, hl = mix13(jh, jl)
	return lh, ll, hh, hl
end

-- Constructs from a raw 128 bit state (lo, hi).
function Xoroshiro.newRaw(lh: number, ll: number, hh: number, hl: number): Xoroshiro
	if lh == 0 and ll == 0 and hh == 0 and hl == 0 then
		lh, ll, hh, hl = GOLDEN_H, GOLDEN_L, SILVER_H, SILVER_L
	end
	return setmetatable({ a = lh, b = ll, c = hh, d = hl }, Xoroshiro) :: any
end

-- Constructs from a 64 bit seed given as (hi, lo).
function Xoroshiro.new(seedH: number, seedL: number): Xoroshiro
	return Xoroshiro.newRaw(upgradeSeed(seedH, seedL))
end

function Xoroshiro.setSeed(self: Xoroshiro, seedH: number, seedL: number)
	self.a, self.b, self.c, self.d = upgradeSeed(seedH, seedL)
end

function Xoroshiro.nextLong(self: Xoroshiro): (number, number)
	local ih, il, jh, jl = self.a, self.b, self.c, self.d
	-- k = rotl(i + j, 17) + i
	local sh, sl = add64(ih, il, jh, jl)
	sh, sl = rotl64(sh, sl, 17)
	local kh, kl = add64(sh, sl, ih, il)
	-- j ^= i
	jh, jl = bxor(jh, ih), bxor(jl, il)
	-- s0 = rotl(i, 49) ^ j ^ (j << 21)
	local rh, rl = rotl64(ih, il, 49)
	local th, tl = shl64(jh, jl, 21)
	self.a, self.b = bxor(rh, jh, th), bxor(rl, jl, tl)
	-- s1 = rotl(j, 28)
	self.c, self.d = rotl64(jh, jl, 28)
	return kh, kl
end

function Xoroshiro.nextInt(self: Xoroshiro, bound: number?): number
	if bound == nil then
		local _, l = self:nextLong()
		return Int64.wrap32(l)
	end
	assert(bound > 0, "bound must be positive")
	local _, i = self:nextLong() -- unsigned low 32 bits
	if bound < 2097152 then
		local j = i * bound
		local k = j % TWO32
		if k < bound then
			local threshold = (TWO32 - bound) % bound
			while k < threshold do
				_, i = self:nextLong()
				j = i * bound
				k = j % TWO32
			end
		end
		return (j - k) / TWO32
	end
	local jh, jl = mul64(0, i, 0, bound)
	local k = jl
	if k < bound then
		local threshold = (TWO32 - bound) % bound
		while k < threshold do
			_, i = self:nextLong()
			jh, jl = mul64(0, i, 0, bound)
			k = jl
		end
	end
	return jh
end

function Xoroshiro.nextIntBetweenInclusive(self: Xoroshiro, lo: number, hi: number): number
	return self:nextInt(hi - lo + 1) + lo
end

function Xoroshiro.nextDouble(self: Xoroshiro): number
	local h, l = self:nextLong()
	return (h * 2097152 + rshift(l, 11)) * TWO53_INV
end

function Xoroshiro.nextFloat(self: Xoroshiro): number
	local h = self:nextLong()
	return rshift(h, 8) * TWO24_INV
end

function Xoroshiro.nextBoolean(self: Xoroshiro): boolean
	local _, l = self:nextLong()
	return band(l, 1) ~= 0
end

function Xoroshiro.consume(self: Xoroshiro, n: number)
	for _ = 1, n do
		self:nextLong()
	end
end

function Xoroshiro.forkPositional(self: Xoroshiro): PositionalFactory
	local lh, ll = self:nextLong()
	local hh, hl = self:nextLong()
	return setmetatable({ lh = lh, ll = ll, hh = hh, hl = hl }, Factory) :: any
end

-- ------------------------------------------------------------------ Mth.getSeed
-- long i = (long)(x * 3129871) ^ (long)z * 116129781L ^ (long)y; i = i*i*42317861L + i*11L; return i >> 16;
local function getSeed(x: number, y: number, z: number): (number, number)
	local xh, xl = Int64.fromInt32(Int64.wrap32(x * 3129871))
	local zh, zl = Int64.fromInt32(z)
	zh, zl = mul64(zh, zl, 0, 116129781)
	local yh, yl = Int64.fromInt32(y)
	local ih, il = xor64(xh, xl, zh, zl)
	ih, il = xor64(ih, il, yh, yl)
	local sqh, sql = mul64(ih, il, ih, il)
	sqh, sql = mul64(sqh, sql, 0, 42317861)
	local eh, el = mul64(ih, il, 0, 11)
	ih, il = add64(sqh, sql, eh, el)
	return Int64.sar(ih, il, 16)
end

-- PositionalRandomFactory.at(x, y, z)
function Factory.at(self: PositionalFactory, x: number, y: number, z: number): Xoroshiro
	local sh, sl = getSeed(x, y, z)
	return Xoroshiro.newRaw(bxor(sh, self.lh), bxor(sl, self.ll), self.hh, self.hl)
end

-- PositionalRandomFactory.fromHashOf(name): md5(name) xor factory seed
function Factory.fromHashOf(self: PositionalFactory, name: string): Xoroshiro
	local lh, ll, hh, hl = Hash.md5Longs(name)
	return Xoroshiro.newRaw(bxor(lh, self.lh), bxor(ll, self.ll), bxor(hh, self.hh), bxor(hl, self.hl))
end

Xoroshiro.getSeed = getSeed
Xoroshiro.upgradeSeed = upgradeSeed

return Xoroshiro
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00015"><Properties><string name="Name">Data</string></Properties><Item class="ModuleScript" referent="RBX00008"><Properties><string name="Name">Biomes</string><ProtectedString name="Source"><![CDATA[--!nocheck
